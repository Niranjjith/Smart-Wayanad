# Vite reads env vars at BUILD time. Only vars starting with VITE_ are exposed.
# For local dev: leave unset to use http://localhost:5000/api
# For Vercel: Project → Settings → Environment Variables → Add

# Name (exact):  VITE_API_BASE_URL
# Value:         https://smart-wayanad.onrender.com/api
# (no trailing slash after api)
